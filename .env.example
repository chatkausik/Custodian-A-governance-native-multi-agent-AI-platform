# Copy this file to .env. It already has working random secrets filled in
# for every local-only service (this is a teaching/demo repo, not a
# production one, so reusing these baked-in values is fine — nothing here
# is reachable from outside your own machine).
#
# The only two lines you MUST change are the [API KEY] ones below — get a
# real key from each provider's website. Everything marked [AUTO-FILLED]
# should stay blank; a setup script in README.md §3 fills it in for you.

COMPOSE_PROJECT_NAME=custodian

# --- Shared Postgres (one instance, one DB+role per service) ---
POSTGRES_SUPERUSER=custodian_root
POSTGRES_SUPERUSER_PASSWORD=f56f31278769590ff6831bb46d810782

# Per-service database passwords (shared Postgres instance, isolated DB+role each)
PGPASS_KEYCLOAK=f25fbb2512814470831d60aff7508b0f
PGPASS_INFISICAL=02d6756c7e8c0a3bd942cd2ba17e4af9
PGPASS_LITELLM=e76bf529d2daa2d9aece5899e64d56d7
PGPASS_MLFLOW=e86a28e9d786e6d92be6cdf08fa51358
PGPASS_LANGFUSE=048e5ea9298884bfe2e68f355132b09a
PGPASS_CUSTODIAN_LEDGER=5359f7d486d201e4d2465834f838a5e3
PGPASS_CUSTODIAN_BACKEND=efbd915b880a33a9a466cf7f8af22543

# --- Shared MinIO (audit-log bucket with Object Lock, langfuse-blobs bucket without) ---
MINIO_ROOT_USER=custodian_admin_f9dbb7bc
MINIO_ROOT_PASSWORD=7cd9a9a5b08b210fe9969eb503a7d384

# --- Real provider API keys ---
OPENAI_API_KEY=sk-replace-me                                          # [API KEY] https://platform.openai.com/api-keys
GROQ_API_KEY=gsk-replace-me                                           # [API KEY] https://console.groq.com/keys

# --- Infisical bootstrap (self-hosted) ---
INFISICAL_ENCRYPTION_KEY=1aac3eae8d64c25c6eb0530d1f702fa3
INFISICAL_AUTH_SECRET=521d6df929f51748bce31e8e361ee04e

# --- Keycloak bootstrap admin (local dev only, rotated after first login) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=e00c7d20c7db9b4d67682cda4a800654
KEYCLOAK_BACKEND_CLIENT_SECRET=89960ab3297bf82a03f581ec8a3102fe
KEYCLOAK_CONSOLE_CLIENT_SECRET=b6dc2f26ed5024f0f903596e9cdf9107
DEMO_AP_CLERK_PASSWORD=b7b875f9e135ebe1
DEMO_CONTROLLER_PASSWORD=b310507ffd40a935
DEMO_CFO_PASSWORD=4b3ae1928486cf3d

# --- Infisical instance-admin bootstrap identity (local dev only) ---
INFISICAL_ADMIN_EMAIL=admin@custodian.local
INFISICAL_ADMIN_PASSWORD=a9abfe0aa6c0c18ced5016e8
INFISICAL_ADMIN_ORGANIZATION=custodian
INFISICAL_ORG_ID=                                                     # [AUTO-FILLED] by bootstrap-infisical.sh

# --- SPIRE trust domain ---
SPIRE_TRUST_DOMAIN=custodian.local
SPIRE_AGENT_JOIN_TOKEN=                                                # [AUTO-FILLED] by setup-spire.sh

# --- OpenMetadata (dedicated bundled postgres) ---
OM_POSTGRES_ROOT_PASSWORD=29caca64b02aeb9757c089b27dc3a948
AIRFLOW_ADMIN_PASSWORD=e46384b300966edbc847a044

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-custodian-master-f8ea4e4f923d2179c7efa17677ce49ca

# --- custodian-ledger ---
LEDGER_API_KEY=ldg-447cc3e99e6fed66478632e183f4ed48
# Separate, narrower key: risk-scoring's real vendor-history lookup only -
# deliberately not the same key that guards ledger writes.
VENDOR_LOOKUP_API_KEY=vlk-db04cdc5456aa15ef05f52343b061445

# --- Per-agent LiteLLM virtual keys ---
LITELLM_KEY_AGENT_EXTRACTION=                                          # [AUTO-FILLED] printed by provision-litellm-keys.py, paste it in
LITELLM_KEY_AGENT_RISK_SCORING=                                        # [AUTO-FILLED] printed by provision-litellm-keys.py, paste it in
LITELLM_KEY_AGENT_APPROVAL=                                            # [AUTO-FILLED] printed by provision-litellm-keys.py, paste it in
LITELLM_KEY_AGENT_PAYMENT_EXECUTION=                                   # [AUTO-FILLED] printed by provision-litellm-keys.py, paste it in
LITELLM_EXTRACTION_KEY=                                                # [AUTO-FILLED] same value as LITELLM_KEY_AGENT_EXTRACTION above

# --- Infisical brokering for Payment-Execution's ledger calls ---
INFISICAL_PROJECT_ID=                                                  # [AUTO-FILLED] printed by provision-infisical-identities.py, paste it in
PAYMENT_EXECUTION_CLIENT_ID=                                           # [AUTO-FILLED] printed by provision-infisical-identities.py, paste it in
PAYMENT_EXECUTION_CLIENT_SECRET=                                       # [AUTO-FILLED] printed by provision-infisical-identities.py, paste it in

# --- Great Expectations / data loader USAspending slice ---
# Not a secret - which real government agency/year of spending data to load.
USASPENDING_AGENCY="Department of Health and Human Services"
USASPENDING_FISCAL_YEAR=2024

# --- Langfuse (observability): own ClickHouse + Redis, shared Postgres/MinIO ---
LANGFUSE_SALT=aae9a4c9ca6105f2a607e71cf8eac2d6d382a80fdb2a3d9453589faed494ee1f
LANGFUSE_ENCRYPTION_KEY=138d2005a4fe63644a21fca7e5b42d0125de989129d656927c70b6daf2e2792d
LANGFUSE_NEXTAUTH_SECRET=b1560af58f96006bab7b4f1699d6ff229e0f6143876d419ff4246e57503cfcc4
LANGFUSE_CLICKHOUSE_PASSWORD=23842668846d1159a1eb7b820185dd14
LANGFUSE_REDIS_AUTH=84108e339efd529850ab81279d298c13
LANGFUSE_INIT_USER_PASSWORD=508ba64ca04098d266fa08a5
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-fdbb83abd0f6b04f1678d6641e49ae03
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-93171178df776950e53995ee438599b7

